issn = {1939-1315},
journal = {Journal of personality and social psychology},
keywords = {Adolescent,Adult,Empathy,Female,Games, Experimental,Gift Giving,Helping Behavior,Humans,Income,Male,Middle Aged,Models, Psychological,Sex Factors,Social Behavior,Social Class,Social Values,Socioeconomic Factors,Trust,Young Adult},
month = nov,
