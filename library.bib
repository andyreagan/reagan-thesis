journal = {Philosophical transactions. Series A, Mathematical, physical, and engineering sciences},
month = dec,
number = {1849},
pages = {3251--66},
pmid = {17090458},
title = {{Topology, braids and mixing in fluids.}},
url = {http://www.ncbi.nlm.nih.gov/pubmed/17090458},
volume = {364},
year = {2006}
}
