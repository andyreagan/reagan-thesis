@article{Kleeman2008,
abstract = {The El Ni\~{n}o/Southern Oscillation (ENSO) phenomenon is the dominant climatic fluctuation on interannual time scales. It is an irregular oscillation with a distinctive broadband spectrum. In this article, we discuss recent theories that seek to explain this irregularity. Particular attention is paid to explanations that involve the stochastic forcing of the slow ocean modes by fast atmospheric transients. We present a theoretical framework for analysing this picture of the irregularity and also discuss the results from a number of coupled ocean-atmosphere models. Finally, we briefly review the implications of the various explanations of ENSO irregularity to attempts to predict this economically significant phenomenon.},
author = {Kleeman, Richard},
doi = {10.1098/rsta.2008.0048},
file = {:Users/lewismitchell1984/Documents/Articles/Kleeman - 2008 - Stochastic theories for the irregularity of ENSO.pdf:pdf},
issn = {1364-503X},
journal = {Philosophical transactions. Series A, Mathematical, physical, and engineering sciences},
keywords = {1,climate oscillation,enso,from the annual to,irregular,nin,observational background,on time scales ranging,predictability,stochastic,system is the el,the decadal,the dominant form of,variability within the climate},
month = jul,
number = {1875},
pages = {2511--26},
pmid = {18445567},
title = {{Stochastic theories for the irregularity of ENSO.}},
url = {http://www.ncbi.nlm.nih.gov/pubmed/18445567},
volume = {366},
year = {2008}
}
@article{Easterlin2010,
abstract = {The striking thing about the happiness-income paradox is that over the long-term--usually a period of 10 y or more--happiness does not increase as a country's income rises. Heretofore the evidence for this was limited to developed countries. This article presents evidence that the long term nil relationship between happiness and income holds also for a number of developing countries, the eastern European countries transitioning from socialism to capitalism, and an even wider sample of developed countries than previously studied. It also finds that in the short-term in all three groups of countries, happiness and income go together, i.e., happiness tends to fall in economic contractions and rise in expansions. Recent critiques of the paradox, claiming the time series relationship between happiness and income is positive, are the result either of a statistical artifact or a confusion of the short-term relationship with the long-term one.},
author = {Easterlin, Richard A. and McVey, Laura Angelescu and Switek, Malgorzata and Sawangfa, Onnicha and Zweig, Jacqueline Smith},
doi = {10.1073/pnas.1015962107},
file = {:Users/lewismitchell1984/Documents/Articles/Easterlin\_PNAS\_2010.pdf:pdf},
issn = {1091-6490},
journal = {Proceedings of the National Academy of Sciences of the United States of America},
keywords = {Developing Countries,Female,Happiness,Humans,Income,Income: statistics \& numerical data,Latin America,Male,Personal Satisfaction,Regression Analysis},
month = dec,
number = {52},
pages = {22463--8},
pmid = {21149705},
title = {{The happiness-income paradox revisited.}},
url = {http://www.pubmedcentral.nih.gov/articlerender.fcgi?artid=3012515\&tool=pmcentrez\&rendertype=abstract},
volume = {107},
year = {2010}
}
